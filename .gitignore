# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.swp
/server_*

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/
bin/

.idea/
*.iml
.vscode/settings.json
.claude

tmp/
tmpFiles/
*.tmp
logs/
files/
lastupdate.tmp
commentsRouter*.go

# ignore build result
casdoor
/server

# include helm-chart, but not its packaged output
!manifests/casdoor
.env
.agent/
tasks/
# the repository is yarn-only; a bun.lock is a local artifact
bun.lock
*.tgz

# the console has its own .gitignore for these; web-old does not
web/cypress/videos/
web/cypress/screenshots/
web-old/cypress/videos/
web-old/cypress/screenshots/

# Brand assets copied in at image build time (docs/branding.md); never committed
web/public/brand/
web/brand/
